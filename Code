def trade():

    THB_value = getAmount_coin(thaibaht) # เรียกดู จำนวน เงินบาทในพอร์ต
    coin_Amount = getAmount_coin(mycoin) # เรียกดู จำนวน เหรียญในพอร์ต
    price_mycoin = getPrice(pair_mycoin) # เรียกดู ราคา เหรียญ
    value_of_mycoin = coin_Amount * price_mycoin # คำนวณ มูลค่าเหรียญในพอร์ต
    tagetValue = (value_of_mycoin + THB_value) / 2 # เอา มูลค่าหรียญ รวมกับ มูลค่าเงินบาท แล้ว หารครึ่ง จะได้ มูลค่าที่ต้องปรับ
    diffValue = value_of_mycoin - tagetValue # มูลค่าหรียญในพอร์ต ณ ปัจจุบัน ลบกับ มูลค่าที่ต้องปรับ จะได้มูลค่าส่วนต่าง

    print('เงินในพอร์ต : ' + str(THB_value) +' บาท')
    print('จำนวน SOL : ' + str(coin_Amount))
    print('ราคา SOL : ' + str(price_mycoin)+' บาท')
    print('มูลค่า SOL : ' + str(value_of_mycoin)+' บาท')
    print('มูลค่าส่วนต่าง : '+str(diffValue)+' บาท')

    minDiff = abs(value_of_mycoin) * 0.02  # ขั้นต่ำที่ส่วนต่าง 2% โดยชดเชย 0.25%จาก fee

    if diffValue > 0 and diffValue > minDiff:  # sell ขาย มูลค่าส่วนต่าง ถ้าไม่ติดลบ แสดงว่า ให้ ขายออกได้
        Lot = diffValue / price_mycoin # มูลค่าส่วนต่าง หาร ราคา = จำนวนของ

        # สมมุติ
        # มีทองคำ มูลค่า 135,000บาท, เงินสดในพอร์ต 100,000บาท =  135,000+100,000= 235,000 -> (235,000/2)= มูลค่าที่เเป้าหมายที่ต้อ้งปรับ 117,500 บาท
        # มูลค่า หาร ราคา จะได้ ปริมาณจำนวนของ เช่น มีทองคำ มูลค่า 135,000 บาท ณ ราคา 10,000 บาท/กก. แสดงว่ามี ทองคำ 13.5 กก.
        # 135,000 - 100,000 = 35,000 -> 35,000 /ราคา = จำนวนของที่ต้องซื้อ -> 35,000 /10,000 = จำนวนของ  3.5 กก.


        ask_order_result = place_ask_order(pair_mycoin, Lot, 0, 'market') # ยิงคำสั่ง ขาย
        ask_order_result.to_csv(str('csv_db/tradelog.csv'), index=False)
        saveTocsv(ask_order_result,mycoin)
        print(ask_order_result)

    if diffValue < 0 and abs(diffValue) > minDiff:  # ซื้อ # มูลค่าส่วนต่าง ติดลบ แสดงว่า ต้องซื้อเข้า เพื่อปรับมูลค่าให้สมดุลที่ 50%
        # สมมุติ
        # มีทองคำ มูลค่า 45,000บาท, เงินสดในพอร์ต 100,000บาท =  45,000+100,000= 145,000 -> (145,000/2)= มูลค่าที่เเป้าหมายที่ต้อ้งปรับ 72,500 บาท
        # มูลค่า หาร ราคา จะได้ ปริมาณจำนวนของ เช่น มีทองคำ มูลค่า 45,000 บาท ณ ราคา 10,000 บาท/กก. แสดงว่ามี ทองคำ 4.5 กก.
        # 45,000 - 72,500 = -27,500 -> แอพสรุดให้ผลเป็นบวกเสมอ(-27,500)/ราคา = จำนวนของที่ต้องซื้อ -> abs(-27,500)/10,000 = 2.75 กก.
        # แต่เนื่องด้วย Bitkub ตอนใช้คำสั่งซื้อ มันบังคับให้ ใส่จำนวนเงิน แทนจำนวนของ ทำให้ ใช้ diffValue ได้เลย โดยไม่ต้องหาร หาจำนวนของ แบบตอน ขาย

        Lot = abs(diffValue)

        bid_order_result = place_bid_order(pair_mycoin, Lot, 0, 'market') #ยิงคำสั่งซื้อ
        saveTocsv(bid_order_result,'เงินบาท')
        print(bid_order_result)




