def getPrice(price_mycoin):
    host = 'https://api.bitkub.com'
    path = '/api/v3/market/ticker'

    ts = str(servertime())
    param = {'sym': price_mycoin}
    query_param = gen_query_param(host + path, param)

    payload = [ts, 'GET', path, query_param]

    sig = gen_sign(api_secret, ''.join(payload))
    headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-BTK-TIMESTAMP': ts,
        'X-BTK-SIGN': sig,
        'X-BTK-APIKEY': api_key
    }

    response = requests.request('GET', f'{host}{path}{query_param}', headers=headers, data={}, verify=True)
    r = response.json()
    return float(r[0]['last'])

def coverTimestamp(ts):
    ts_int = int(ts)  # แปลงเป็นตัวเลขก่อน
    dt = datetime.datetime.fromtimestamp(ts_int) # แปลงเป็นเวลาปกติ (local time)
    return dt

def saveTocsv(order_result,coin):
    data = {
        'เหรียญ': coin,
        'จำนวน': order_result['result']['amt'],
        'ไอดี': order_result['result']['id'],
        'เวลา': coverTimestamp(order_result['result']['ts']),
        'ประเภท': order_result['result']['typ']
    }
    df = pd.DataFrame([data])

    csv_path = 'csv_db/tradelog.csv'
    if not os.path.exists(csv_path):
        df.to_csv(csv_path, index=False)  # เขียนไฟล์ใหม่ (พร้อมหัวคอลัมน์)
    else:
        df.to_csv(csv_path, mode='a', header=False, index=False)  # ต่อท้ายข้อมูล



