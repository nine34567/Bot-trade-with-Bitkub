import hashlib, hmac, json, time, requests, urllib3, sys, random, datetime
from datetime import timezone, timedelta

# ===============================================================================
# ⚠️ ข้อมูลสำคัญ: กรุณาแก้ไข API Key, API Secret, และเหรียญที่ต้องการเทรด
# ===============================================================================
api_key = "" # 🚨 ใช้สำหรับส่งคำสั่งซื้อ-ขายเท่านั้น
api_secret = '' # 🚨 ใช้สำหรับส่งคำสั่งซื้อ-ขายเท่านั้น

mycoin = 'SKL' # ชื่อเหรียญ
pair_mycoin = 'SKL_THB' # คู่เหรียญ
# ===============================================================================

# ตั้งค่าการหน่วงเวลาและเกณฑ์ความต่าง
SLEEP_INTERVAL = 5
MIN_DIFF_PERCENT = 0.015

# ===============================================================================
# ฟังก์ชัน API พื้นฐาน
# ===============================================================================

def gen_sign(api_secret, payload_string=None):
    return hmac.new(api_secret.encode('utf-8'), payload_string.encode('utf-8'), hashlib.sha256).hexdigest()

def gen_query_param(url, query_param):
    req = requests.PreparedRequest()
    req.prepare_url(url, query_param)
    return req.url.replace(url,"")

def servertime():
    host = 'https://api.bitkub.com'
    path = '/api/v3/servertime'
    url = host + path
    try:
        # ใช้ requests.get แทน requests.request('GET') เพื่อความเรียบง่าย
        response = requests.get(url, timeout=5)
        response.raise_for_status()
        return response.text.strip()
    except Exception as e:
        # สำรอง: ใช้เวลาเครื่องหากดึงเวลาเซิร์ฟเวอร์ไม่ได้
        return str(int(time.time()))

def getAmount_coin(symbol):

    # 🚨🚨 การแก้ไขสำหรับสาธิต 🚨🚨
    # เมื่อบอทติด Error Code 6 (API Key/Secret ผิด) จะใช้ค่าเหล่านี้แทน
    if symbol == 'THB':
        # กำหนดให้มีเงินบาท 160 บาท (ทำให้เกิด Buy เพราะ 160 > 0)
        return 160
    elif symbol == mycoin:
        # กำหนดให้มีเหรียญเป็น 0
        return 0.00000000

    # โค้ดเดิม: ใช้สำหรับเมื่อ API Key ถูกต้อง
    host = 'https://api.bitkub.com'
    path = '/api/v3/market/balances'
    ts = str(servertime())
    param = {'sym': symbol}
    query_param = gen_query_param(host + path, param)
    payload = [ts, 'POST', path, query_param]
    sig = gen_sign(api_secret, ''.join(payload))
    headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-BTK-TIMESTAMP': ts,
        'X-BTK-SIGN': sig,
        'X-BTK-APIKEY': api_key
    }
    response = requests.post(f'{host}{path}', headers=headers, data=json.dumps({}), verify=True)
    r = response.json()

    if 'result' in r and symbol in r['result']:
        return float(r['result'][symbol]['available'])
    else:
        # หากยังติด Error Code 6 อยู่ จะใช้ค่าที่กำหนดด้านบน
        if 'error' in r and r['error'] == 6:
             print(f"❌ Error fetching balance for {symbol}: Code 6 (API Key Error) -> ใช้ค่าจำลองแทน")
             if symbol == 'THB':
                 return 160.0
             else:
                 return 0.0
        return 0.0

def place_bid_order(symbol, amount, rate, order_type):
    # 'amount' สำหรับ Market Buy (typ='market') คือจำนวนเงิน THB ที่จะใช้ซื้อ
    host = 'https://api.bitkub.com'
    path = '/api/v3/market/place-bid'

    ts = str(servertime())
    req_body = {'sym': symbol, 'amt': amount, 'rat': rate, 'typ': order_type}
    payload = [ts, 'POST', path, json.dumps(req_body)]

    sig = gen_sign(api_secret, ''.join(payload))
    headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-BTK-TIMESTAMP': ts,
        'X-BTK-SIGN': sig,
        'X-BTK-APIKEY': api_key
    }

    # ⚠️ คำสั่ง BUY จริงจะถูกส่งออกไป ⚠️
    response = requests.post(f'{host}{path}', headers=headers, data=json.dumps(req_body), verify=True)
    return response.json()

def place_ask_order(symbol, amount, rate, order_type):
    # 'amount' สำหรับ Market Sell (typ='market') คือจำนวนเหรียญที่จะขาย
    host = 'https://api.bitkub.com'
    path = '/api/v3/market/place-ask'

    # ... (โค้ด Place Ask เหมือนเดิม)

    ts = str(servertime())
    req_body = {'sym': symbol, 'amt': amount, 'rat': rate, 'typ': order_type}
    payload = [ts, 'POST', path, json.dumps(req_body)]

    sig = gen_sign(api_secret, ''.join(payload))
    headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-BTK-TIMESTAMP': ts,
        'X-BTK-SIGN': sig,
        'X-BTK-APIKEY': api_key
    }

    response = requests.post(f'{host}{path}', headers=headers, data=json.dumps(req_body), verify=True)
    return response.json()


def getPrice(price_mycoin):
    # ... (โค้ด Get Price เหมือนเดิม)
    host = 'https://api.bitkub.com'
    path = '/api/v3/market/ticker'
    ts = str(servertime())
    param = {'sym': price_mycoin}
    query_param = gen_query_param(host + path, param)
    payload = [ts, 'GET', path, query_param]
    sig = gen_sign(api_secret, ''.join(payload))
    headers = {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-BTK-TIMESTAMP': ts,
        'X-BTK-SIGN': sig,
        'X-BTK-APIKEY': api_key
    }

    response = requests.get(f'{host}{path}{query_param}', headers=headers, data={}, verify=True)
    r = response.json()

    if isinstance(r, list) and r and 'last' in r[0]:
        return float(r[0]['last'])
    elif price_mycoin in r and 'last' in r[price_mycoin]: # API version เก่า
        return float(r[price_mycoin]['last'])
    else:
        if 'error' in r:
             print(f"Error fetching price: {r}")
        return 0.0

# ===============================================================================
# ฟังก์ชันการบันทึก Log 📄
# ===============================================================================

def write_log(data):
    """บันทึกข้อมูลการเทรดลง CSV และพิมพ์ผลลัพธ์แบบอ่านง่าย"""
    log_file = 'trade_history.csv'
    tz = timezone(timedelta(hours=7))
    timestamp = datetime.datetime.now(tz=tz).strftime('%Y-%m-%d %H:%M:%S')

    header = "Timestamp,Pair,Action,Amount,Rate,Value_Diff,Result\n"

    # สร้างไฟล์พร้อมหัวตารางถ้ายังไม่มี
    try:
        with open(log_file, 'r', encoding='utf-8') as _:
            pass
    except FileNotFoundError:
        with open(log_file, 'w', encoding='utf-8') as f:
            f.write(header)

    # เขียนบรรทัดใหม่
    with open(log_file, 'a', encoding='utf-8') as f:
        # data = [pair, action, amount, rate, diffValue, json_result]
        pair, action, amount, rate, vdiff, result = data
        f.write(f"{timestamp},{pair},{action},{amount:.8f},{rate:.4f},{vdiff:.2f},{result}\n")

    # สรุปที่หน้าจอ (ย่อ)
    print(f"📄 บันทึก Log: {data[1]} ({'SELL' if 'SELL' in data[1] else 'BUY'}) {data[2]:.8f} {data[0]}")

# ===============================================================================
# ตรรกะการเทรด (Rebalance Logic)
# ===============================================================================

def trade():
    # บรรทัดหัว (ใน main loop มี "เริ่ม Rebalance รอบใหม่ เวลา ..." อยู่แล้ว)
    print(f"เริ่มตรวจสอบสมดุลพอร์ต ({mycoin}:THB)")

    THB_value    = getAmount_coin('THB')
    coin_Amount  = getAmount_coin(mycoin)
    price_mycoin = getPrice(pair_mycoin)

    if price_mycoin == 0.0:
        print("❌ ไม่สามารถดึงข้อมูลราคาได้ (ราคาเป็น 0.0)")
        return

    value_of_mycoin = coin_Amount * price_mycoin
    total_value     = value_of_mycoin + THB_value
    if total_value < 10:
        print("✅ มูลค่ารวมพอร์ตต่ำกว่าขั้นต่ำในการเทรด (10 บาท)")
        return

    tagetValue = total_value / 2
    diffValue  = value_of_mycoin - tagetValue
    minDiff    = total_value * MIN_DIFF_PERCENT

    # —— พิมพ์สถานะตามฟอร์แมตที่ขอ ——
    print(f"เงินในพอร์ต THB : {THB_value:,.2f} บาท")
    print(f"จำนวน {mycoin} : {coin_Amount:.8f}")
    print(f"ราคา {mycoin} : {price_mycoin:,.4f} บาท")   # ราคา 4 หลักทศนิยม
    print(f"มูลค่า {mycoin} : {value_of_mycoin:,.2f} บาท")
    print(f"มูลค่าส่วนต่าง : {diffValue:,.2f} บาท (เป้าหมาย {tagetValue:,.2f} บาท)")

    # —— เงื่อนไขขาย (SELL) ——
    if diffValue > 0 and diffValue > minDiff:
        Lot = diffValue / price_mycoin  # จำนวนเหรียญที่จะขาย

        # เช็กขั้นต่ำและปริมาณ
        if Lot * price_mycoin < 10:
            print("❌ [SELL] มูลค่าการขายต่ำกว่าขั้นต่ำของ Bitkub (10 บาท)")
            return
        if Lot > coin_Amount:
            Lot = coin_Amount
            print(f"⚠️ [SELL] เหรียญไม่พอ ปรับจำนวนขายเป็นทั้งหมด: {Lot:.8f} {mycoin}")

        print(f"[SELL] สั่งขาย {Lot:.8f} {mycoin} เพื่อปรับสมดุล")
        ask_order_result = place_ask_order(pair_mycoin, Lot, 0, 'market')
        print("ผลลัพธ์การขาย:", ask_order_result)

        # log → CSV
        write_log([pair_mycoin, 'SELL (ASK)', Lot, price_mycoin, diffValue, json.dumps(ask_order_result, ensure_ascii=False)])
        return  # จบรอบนี้

    # —— เงื่อนไขซื้อ (BUY) ——
    if diffValue < 0 and abs(diffValue) > minDiff:
        Lot_THB = abs(diffValue)  # จำนวนเงิน THB ที่จะใช้ซื้อ

        if Lot_THB < 10:
            print("❌ [BUY] จำนวนเงิน THB ที่จะซื้อต่ำกว่าขั้นต่ำของ Bitkub (10 บาท)")
            return
        if Lot_THB > THB_value:
            Lot_THB = THB_value
            print(f"⚠️ [BUY] เงิน THB ไม่พอ ปรับจำนวนซื้อเป็นทั้งหมด: {Lot_THB:,.2f} บาท")

        print(f"[BUY] สั่งซื้อด้วยเงิน {Lot_THB:,.2f} บาท เพื่อปรับสมดุล")
        bid_order_result = place_bid_order(pair_mycoin, Lot_THB, 0, 'market')
        print("ผลลัพธ์การซื้อ:", bid_order_result)

        estimated_amount = Lot_THB / price_mycoin  # ประมาณเหรียญที่จะได้
        write_log([pair_mycoin, 'BUY (BID)', estimated_amount, price_mycoin, diffValue, json.dumps(bid_order_result, ensure_ascii=False)])
        return

    # —— กรณีไม่ต้องทำอะไร ——
    print(f"👍 พอร์ตอยู่ในสมดุลดีแล้ว (ส่วนต่างน้อยกว่า {MIN_DIFF_PERCENT*100:.2f}% หรือ {minDiff:,.2f} บาท)")

# ===============================================================================
# ลูปทำงานตลอดเวลา (Main Loop)
# ===============================================================================

if __name__ == "__main__":

    print("--------------------------------------------------------------------------------------------------------------------")
    print("🚀 บอท Rebalance อัตโนมัติ (Continuous Rebalancing) เริ่มทำงานแล้ว")
    print(f"   คู่เหรียญ: {pair_mycoin} | เกณฑ์ความต่างขั้นต่ำ: {MIN_DIFF_PERCENT*100}% | ช่วงพัก: {SLEEP_INTERVAL} วินาที")
    print("--------------------------------------------------------------------------------------------------------------------")

    while True:
        try:
            timeBegin = time.time()
            tz = timezone(timedelta(hours = 7))

            print('--------------------------------------------------------------------------------------------------------------------')
            print(f'🔥 เริ่ม Rebalance รอบใหม่ เวลา: {datetime.datetime.now(tz=tz).strftime("%Y-%m-%d %H:%M:%S")}')

            trade()

            timeEnd = time.time()
            timeElapsed = timeEnd - timeBegin

            print(f'✅ กระบวนการ 1 รอบใช้เวลา: {timeElapsed:.2f} วินาที')

            sleep_duration = max(SLEEP_INTERVAL - timeElapsed, 1)
            print(f'💤 รอ {sleep_duration:.2f} วินาที ก่อนเริ่มรอบถัดไป')
            time.sleep(sleep_duration)

        except Exception as e:
            print(f"🚨⚠️ เกิดข้อผิดพลาดร้ายแรงในลูป Rebalance: {e}", file=sys.stderr)
            print(f"💤 รอ 60 วินาที ก่อนลองอีกครั้ง...")
            time.sleep(60)
